<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="testDataSetUp" class="dao.TestDataCleaner">
        <constructor-arg ref="jdbcTemplate"/>
    </bean>
    <bean id="rentalDao" class="dao.RentalDaoJdbc">
        <constructor-arg ref="jdbcTemplate"/>
    </bean>
    <bean id="rentalService" class="service.RentalService">
        <constructor-arg ref="rentalDao"/>
    </bean>
    <bean id="bookItemService" class="service.BookItemService">
        <constructor-arg ref="bookItemDao"/>
        <constructor-arg ref="rentalService"/>
    </bean>

    <bean id="bookService" class="service.BookService">
        <constructor-arg ref="bookItemService"/>
        <constructor-arg ref="bookDao"/>
    </bean>

    <bean id="bookDao" class="dao.BookDaoJdbc">
        <constructor-arg ref="jdbcTemplate"/>
    </bean>

    <bean id="bookItemDao" class="dao.BookItemDaoJdbc">
        <constructor-arg ref="jdbcTemplate"/>
    </bean>

    <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="com.mysql.cj.jdbc.Driver"/>
        <property name="url" value="jdbc:mysql://localhost:3306/book_rental"/>
        <property name="username" value="root"/>
        <property name="password" value="1994"/>
    </bean>




</beans>